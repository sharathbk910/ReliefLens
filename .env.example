# ReliefLens Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (public — safe to expose in browser, do NOT put secrets here)
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=               # e.g. https://xyz.supabase.co
VITE_SUPABASE_ANON_KEY=          # Supabase anon/public key (starts with eyJ...)
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — Set these via Supabase Edge Function secrets, NOT here
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=              ← Set in Supabase Dashboard > Edge Functions > Secrets
# GEMINI_MODEL=gemini-2.5-flash   ← Optional override (default: gemini-2.5-flash)
#
# HOW: npx supabase secrets set GEMINI_API_KEY="AIzaSy..."
# DO NOT put GEMINI_API_KEY in this file or any VITE_ variable!
